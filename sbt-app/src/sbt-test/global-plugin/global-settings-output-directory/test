# Move the global plugin output, delete the old one, and load global settings that use the global plugin.
$ copy-file changes/out.sbt global/plugins/out.sbt
$ delete target/out
$ copy-file changes/use.sbt global/use.sbt
> reload

# Load the build again, so the global plugin classes come from the cache.
> reload

# The tests of one scripted run share `global`, so delete what this test installed there.
$ delete global/plugins global/use.sbt
