# a forked test's working directory is sbt's working directory by default (#1032)
> sub/testFull
$ exists cwd-marker
$ absent sub/cwd-marker
$ delete cwd-marker

# Test / forkWorkingDirectory restores forking in the project directory
$ copy-file changes/forkdir.sbt sub/forkdir.sbt
> reload
> sub/testFull
$ exists sub/cwd-marker
$ absent cwd-marker
