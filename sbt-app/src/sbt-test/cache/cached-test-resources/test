> app/Test/checkResourceDigests
> app/test
> remapped/test
> shadowed/test

# a changed main resource invalidates the cached test results
$ copy-file app/src/main/resources/app.txt saved/app.txt
$ copy-file changes/other.txt app/src/main/resources/app.txt
-> app/test

# changed back, the earlier result is reused, so the test doesn't run
$ copy-file saved/app.txt app/src/main/resources/app.txt
$ delete ran
> app/test
$ absent ran

# so does a changed resource of a project that the tests depend on, also indirectly
$ copy-file core/src/main/resources/core.txt saved/core.txt
$ copy-file changes/other.txt core/src/main/resources/core.txt
-> app/test
$ copy-file saved/core.txt core/src/main/resources/core.txt
$ copy-file util/src/main/resources/util.txt saved/util.txt
$ copy-file changes/other.txt util/src/main/resources/util.txt
-> app/test
$ copy-file saved/util.txt util/src/main/resources/util.txt
$ delete ran
> app/test
$ absent ran

# swapping the contents of two resources with the same path on the classpath invalidates the
# results too, whichever of them the test reads
$ copy-file shadowed/src/main/resources/shadow.txt saved/shadow.txt
$ copy-file shadowed/extra-resources/shadow.txt shadowed/src/main/resources/shadow.txt
$ copy-file saved/shadow.txt shadowed/extra-resources/shadow.txt
$ delete ran-shadowed
> shadowed/test
$ exists ran-shadowed

# and so does removing one of two equal resources of different projects
$ copy-file app/src/main/resources/same.txt saved/same.txt
$ delete app/src/main/resources/same.txt
-> app/test
$ copy-file saved/same.txt app/src/main/resources/same.txt

# and a changed test resource, also when the classpath configuration is another one
$ copy-file changes/other.txt remapped/src/test/resources/remapped.txt
-> remapped/test

# a resource moved to another resource directory keeps its path on the classpath, and the result
$ copy-file app/src/main/resources/app.txt app/extra-resources/app.txt
$ delete app/src/main/resources/app.txt
$ delete ran
> app/test
$ absent ran

# but a renamed resource invalidates the results, also with the same content
$ copy-file app/extra-resources/app.txt app/extra-resources/renamed.txt
$ delete app/extra-resources/app.txt
-> app/test
